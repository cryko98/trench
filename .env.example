# Upstash Redis (free tier: https://console.upstash.com — create a Redis database,
# then copy the REST URL and token). Without these the app falls back to an
# in-memory store, which is fine for local dev but resets on every restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: your own Solana RPC endpoint (defaults to the public mainnet RPC).
NEXT_PUBLIC_SOLANA_RPC=

# The $socials contract address and X account, shown in the header.
# Until they are set the header shows "CA coming soon" and a dimmed X icon.
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_X_URL=

# Caller rewards: the wallet that collects the $socials creator reward, shown
# on /rewards with its live balance. ADMIN_WALLET may record payouts there.
NEXT_PUBLIC_REWARD_WALLET=
NEXT_PUBLIC_REWARD_PAYOUT_RATIO=0.5
ADMIN_WALLET=

# Optional: canonical site URL for social cards
NEXT_PUBLIC_SITE_URL=

# Server-side RPC, used for token-gated community checks and for reading
# pump.fun bonding curves. Strongly recommended: the public mainnet endpoint
# is heavily rate limited. A free Helius key looks like:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Keep it here only — this file's real values live in .env.local, which git ignores.
SOLANA_RPC=
